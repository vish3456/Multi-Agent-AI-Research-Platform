# =============================================================================
# Multi-Agent AI Research Platform — Environment Variables
# Copy this file to .env and fill in your values
# =============================================================================

# --- API ---
API_KEY=your-api-key-here
APP_PORT=8000

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- PostgreSQL ---
DATABASE_URL=postgresql://postgres:localdev@localhost:5432/research_platform

# --- AWS Bedrock Guardrails ---
GUARDRAIL_ID=your-guardrail-id
GUARDRAIL_VERSION=DRAFT
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# --- TensorZero Gateway ---
TENSORZERO_URL=http://localhost:3000

# --- Embeddings ---
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384

# --- Cache Thresholds ---
CACHE_SIMILARITY_THRESHOLD=0.85
LTM_EXACT_THRESHOLD=0.88
LTM_RELATED_THRESHOLD=0.50

# --- LLM Provider Keys (used by TensorZero) ---
OPENAI_API_KEY=sk-your-openai-key
GROQ_API_KEY=gsk_your-groq-key

# --- LangSmith ---
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=multi-agent-research

# --- Rate Limiting ---
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW=60
